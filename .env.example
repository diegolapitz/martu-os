# Local development uses a persistent embedded PostgreSQL engine.
DB_MODE=pglite
PGLITE_DATA_DIR=.data/martu-os
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Legacy local access gate. Production uses Supabase Auth below.
MARTU_ACCESS_CODE=
MARTU_SESSION_SECRET=
MARTU_ALLOW_LEGACY_AUTH=false

# Supabase Auth (email + password, cookie-based SSR sessions).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase production/serverless connection.
# Use the transaction pooler URL for DATABASE_URL and the direct URL for migrations.
DATABASE_URL=
DIRECT_URL=

# Real AI is optional. Without a key the same flows run through the demo provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Scheduler called by Supabase Cron.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push. Generate local keys with: pnpm vapid:generate
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:martu-os@example.com
PUSH_TEST_TOKEN=

# Optional deployment metadata used only by setup scripts/documentation.
SUPABASE_PROJECT_REF=

# Instagram API with Instagram Login (server-only; never prefix secrets with NEXT_PUBLIC_).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/oauth/callback
# Generate two different secrets, for example: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_OAUTH_STATE_SECRET=
